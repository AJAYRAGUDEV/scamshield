# Copy to .env and fill in. Never commit .env. The Gemini key lives on the server only:
# the backend never reads a key from a request (form field, header or query string).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
APP_ENV=development
LOG_LEVEL=INFO

# Approved limits
MAX_TEXT_LENGTH=20000
MAX_AUDIO_SIZE_MB=20
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=300

# Video (Phase 8). Requires ffprobe (FFmpeg) on the server. Jobs are in memory and are lost on restart.
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_SECONDS=20
GEMINI_VIDEO_TIMEOUT_SECONDS=240
GEMINI_FILE_POLL_INTERVAL_SECONDS=2
GEMINI_FILE_READY_TIMEOUT_SECONDS=120
VIDEO_WORKERS=1
VIDEO_MAX_ACTIVE_JOBS=4
VIDEO_MAX_ACTIVE_JOBS_PER_CLIENT=2
VIDEO_JOB_TIMEOUT_SECONDS=330
VIDEO_JOB_TTL_SECONDS=900

# Gemini protection
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_CONCURRENCY=4
GEMINI_MAX_QUEUE=8
GEMINI_MAX_RETRIES=1
GEMINI_QUOTA_COOLDOWN_SECONDS=30

# Rate limits (slowapi syntax; in-memory, single process only). Per client unless noted.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TEXT=30/minute
RATE_LIMIT_AUDIO=10/minute
RATE_LIMIT_VIDEO=3/minute
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_GLOBAL=120/minute
# Comma-separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For. Leave blank unless you run one.
TRUSTED_PROXY_IPS=

# Web security
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000
ENABLE_HSTS=false
# Blank = <system temp>/scamshield-uploads
TEMP_UPLOAD_DIR=
